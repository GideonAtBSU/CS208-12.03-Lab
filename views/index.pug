extends layout

block content
  h1= title
  p Welcome to #{title}

  table
    thead
      tr
        th Task
        th Status
        th Description
        th
    tbody
      each val in todos
        tr
          td= val.task
          td
            form(method='POST' action='/complete' class='sideBtn')
              input(type='hidden' name='id' value=val.id)
              button(type='submit' class="complete")= val.completed > 0 ? 'Completed' : 'Not Completed'
          td
            form(method='POST' action='/edit' class='sideBtn')
              input(type='hidden' name='id' value=val.id)
              input(type='text' name='description' value=val.description placeholder='Add a description')
              button(type='submit' class="edit") Save
          td
            form(method='POST' action='/delete' class='sideBtn')
              input(type='hidden' name='id' value=val.id)
              button(type='submit' class="delete") Delete

  hr
  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task')
    button(type='submit' class="create") Create Task

  script(src='/javascripts/toasts.js')